{
  "name": "stc-mezclas-poc-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test ../tests/*.test.mjs ../tests/blend/*.test.mjs ../tests/hvi/*.test.mjs",
    "db:status": "node scripts/migrate.js --status",
    "db:migrate": "node scripts/migrate.js",
    "user:create": "node scripts/create-user.js",
    "dev:account": "node scripts/setup-local-user.js",
    "backup:create": "node scripts/backup.js create",
    "backup:verify": "node scripts/backup.js verify",
    "backup:restore-test": "node scripts/backup.js restore-test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^9.0.0",
    "pg": "^8.11.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
