# Complete these values. No default database credentials exist.
NODE_ENV=development
HOST=127.0.0.1
PORT=3005
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173
STC_TRUST_PROXY=false
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=stc_produccion
PG_USER=stc_app
PG_PASSWORD=
PG_SSL=false
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=120000
PG_POOL_MAX=10
# Migration credentials: only CLI commands use them.
PG_MIGRATION_USER=
PG_MIGRATION_PASSWORD=
# Backup/read privileges. Optional: defaults to runtime credentials.
PG_BACKUP_USER=
PG_BACKUP_PASSWORD=
# Restore-test credentials need CREATEDB; never grant that to the runtime role.
PG_MAINTENANCE_USER=
PG_MAINTENANCE_PASSWORD=
GOOGLE_API_KEY=
STC_SESSION_HOURS=8
STC_SESSION_IDLE_MINUTES=30
STC_BACKUP_ENABLED=true
# Blank means backend/backups. Set mirror to another disk/location.
STC_BACKUP_DIR=
STC_BACKUP_MIRROR_DIR=
STC_BACKUP_QUIET_WINDOW_MS=900000
STC_BACKUP_MIN_INTERVAL_MS=7200000
STC_BACKUP_PERIODIC_MS=86400000
STC_BACKUP_TIMEOUT_MS=600000
STC_PG_TOOL_MODE=podman
STC_PG_CONTAINER=stc_postgres
STC_PG_CONTAINER_PORT=5432
# Native PostgreSQL binaries can be configured with STC_PG_BIN_DIR.
